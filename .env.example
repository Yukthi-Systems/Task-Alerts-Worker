
POSTGRES_DB_URL=postgres://user:password@localhost:5432/tasks?sslmode=require

RABBITMQ_DOMAIN=rabbitmq.example.com
RABBITMQ_USER_NAME=
RABBITMQ_PASSWORD=
RABBITMQ_VIRTUAL_HOST=/
RABBITMQ_EXCHANGE_NAME=
RABBITMQ_ROUTING_KEY=

# Base URL of the web app;
APP_URL=https://calendar.example.com

# Firebase app name in V3-Notifications-Worker's FIREBASE_APPS
FCM_APP_NAME=calendar


TICK_SECONDS=300
BATCH_SIZE=100
PUBLISH_PARALLEL=10
STALE_AFTER=1h
